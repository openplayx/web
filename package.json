{
  "name": "openplayx-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The bilingual OpenPlayX website, deployed with Cloudflare Workers Static Assets.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev": "npm run build && wrangler dev",
    "preview": "npm run build && wrangler dev",
    "refresh:releases": "node scripts/update-releases.mjs",
    "deploy": "npm test && npm run test:integration && npm run build && npm run check && wrangler deploy",
    "test": "node --test test/*.test.mjs scripts/*.test.mjs",
    "test:integration": "node scripts/test-worker-integration.mjs",
    "deploy:admin": "npm test && npm run test:integration && wrangler deploy --config wrangler.admin.jsonc",
    "dev:admin": "wrangler dev --config wrangler.admin.jsonc"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.162.0",
    "jsdom": "26.1.0",
    "miniflare": "5.20261113.0-beta"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "posthog-js": "1.451.2"
  }
}
