{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openplayx-admin",
  "main": "src/admin-worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.openplayx.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "openplayx-server"
    }
  ]
}
