{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openplayx-web",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "openplayx.com",
      "custom_domain": true
    },
    {
      "pattern": "www.openplayx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/account/*",
      "/adminzzz",
      "/adminzzz/*",
      "/v1/*"
    ]
  },
  "main": "src/worker.mjs",
  "services": [
    {
      "binding": "API",
      "service": "openplayx-server"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_SESSIONS",
        "class_name": "AccountSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "account-sessions-v1",
      "new_sqlite_classes": [
        "AccountSession"
      ]
    }
  ],
  "version_metadata": {
    "binding": "VERSION_METADATA"
  }
}
