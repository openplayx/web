{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openplayx-web",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "openplayx.com",
      "custom_domain": true
    },
    {
      "pattern": "www.openplayx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/account/*",
      "/adminzzz",
      "/adminzzz/*",
      "/v1/*"
    ]
  },
  "main": "src/worker.mjs",
  "services": [
    {
      "binding": "API",
      "service": "openplayx-server"
    }
  ]
}
